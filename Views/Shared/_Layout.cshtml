@{
    var categories = new[] { "Bota", "Rajoni", "Vendi", "Sport", "ShowBiz" };
    var current = ViewData["Category"] as string;
    string ActiveClass(string c) => string.Equals(c, current, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="sq">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PULSE</title>
    <link rel="icon" type="image/jpeg" href="~/images/logo.jpeg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Topbar -->
    <div class="topbar">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="live-badge"><span class="dot"></span> LIVE</span>
            <span class="topbar-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("sq-AL"))</span>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg pulse-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.jpeg" alt="PULSE" class="brand-logo" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(current == null && (ViewContext.RouteData.Values["action"]?.ToString() == "Index") ? "active" : "")"
                           asp-controller="Home" asp-action="Index">Ballina</a>
                    </li>
                    @foreach (var c in categories)
                    {
                        <li class="nav-item">
                            <a class="nav-link @ActiveClass(c)" href="/Lajme/@c">@c</a>
                        </li>
                    }
                </ul>
                <div class="d-flex">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-pulse-outline me-2" asp-controller="Admin" asp-action="Dashboard">Paneli</a>
                        <a class="btn btn-pulse-outline" asp-controller="Admin" asp-action="Logout">Dil</a>
                    }
                    else
                    {
                        <a class="btn btn-pulse" asp-controller="Admin" asp-action="Login">Kyçu</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="pulse-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-5">
                    <img src="~/images/logo.jpeg" alt="PULSE" class="footer-logo" />
                    <p class="footer-tag">Lajme • Analiza • Informacione</p>
                    <p class="footer-muted">Portali yt i lajmeve më të fundit nga vendi, rajoni dhe bota.</p>
                </div>
                <div class="col-md-7">
                    <h6 class="footer-head">Kategoritë</h6>
                    <ul class="footer-links footer-cats">
                        @foreach (var c in categories)
                        {
                            <li><a href="/Lajme/@c">@c</a></li>
                        }
                    </ul>
                </div>
            </div>
            <hr class="footer-hr" />
            <p class="footer-copy">© @DateTime.Now.Year PULSE. Të gjitha të drejtat e rezervuara.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
