@model LoginViewModel
@{
    ViewData["Title"] = "Kyçu";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="login-card">
            <div class="text-center mb-4">
                <img src="~/images/logo.jpeg" alt="PULSE" class="login-logo" />
                <h3 class="mt-3">Paneli i Adminit</h3>
                <p class="text-muted">Kyçu për të menaxhuar lajmet.</p>
            </div>

            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autofocus />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-pulse w-100">Kyçu</button>
            </form>
        </div>
    </div>
</div>
